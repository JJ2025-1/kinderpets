# ============================================================================
# KINDER PETS ENVIRONMENT CONFIGURATION
# ============================================================================

# 1. Oracle Database Configuration (DBMS DA2)
# Leave ORACLE_PASSWORD empty to automatically use zero-config embedded SQLite.
ORACLE_USER=KINDERPETS
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1

# 2. Neo4j Graph Database Configuration (DBMS DA3)
# Leave NEO4J_PASSWORD empty to automatically use the high-fidelity in-memory Graph Engine.
# For Docker: bolt://localhost:7687 (user: neo4j, password: kinderpets123)
# For Neo4j AuraDB (Cloud): neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
